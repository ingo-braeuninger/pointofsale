{
    "_version": "1.58.0",
    "sap.app": {
        "id": "pos",
        "type": "application",
        "title": "Point of Sale",
        "description": "A simple Point of Sale application",
        "applicationVersion": {
            "version": "1.0.0"
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": false
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "pos.view.App",
            "type": "XML",
            "id": "appView"
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "dependencies": {
            "minUI5Version": "1.100.0",
            "libs": {
                "sap.m": {},
                "sap.ui.layout": {},
                "sap.ui.core": {}
            }
        },
        "models": {
            "": {
                "type": "sap.ui.model.json.JSONModel",
                "settings": {
                    "data": {}
                }
            }
        },
        "routing": {
            "routes": [],
            "targets": {}
        }
    }
}
